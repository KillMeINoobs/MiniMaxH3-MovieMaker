{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmin-video-director.invalid/schemas/2.0.0/reference_binding.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kmin.reference_binding"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$": {}
      },
      "additionalProperties": false
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "image_media_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "content_digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "identity",
        "appearance",
        "costume",
        "object",
        "style"
      ]
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "useful_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "appearance_state_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "description": {
      "type": "string"
    },
    "approved": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "retention_instructions": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "project_id",
    "subject_id",
    "image_media_id",
    "content_digest",
    "role",
    "segment_ids",
    "useful_ranges",
    "appearance_state_id",
    "description",
    "approved",
    "revision",
    "retention_instructions"
  ],
  "additionalProperties": false
}
