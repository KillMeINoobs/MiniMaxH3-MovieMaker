                      "stream_index",
                      "time_base",
                      "first_pts",
                      "end_pts",
                      "pts_digest",
                      "rate",
                      "vfr",
                      "width",
                      "height",
                      "rotation",
                      "sar",
                      "display_matrix",
                      "color",
                      "pixel_format"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "audio": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "codec": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "stream_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "time_base": {
                        "type": "object",
                        "properties": {
                          "num": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "den": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "num",
                          "den"
                        ],
                        "additionalProperties": false
                      },
                      "first_pts": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "sample_rate": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "channels": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "skip_samples": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
