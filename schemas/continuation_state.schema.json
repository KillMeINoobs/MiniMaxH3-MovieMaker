                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96,
                    "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                  },
                  "message": {
                    "type": "string"
                  },
                  "stage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96,
                    "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                  },
                  "retryable": {
                    "type": "boolean"
