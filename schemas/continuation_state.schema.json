  "required": [
    "kind",
    "schema_version",
    "id",
    "project_id",
    "segment_id",
    "window_id",
    "continuity_group_id",
    "predecessor_result_id",
    "predecessor_digest",
    "profile_id",
    "component_signatures",
    "geometry",
    "latent_signatures",
    "artifacts",
    "last_useful_global_end",
    "last_useful_local_end",
    "video_tail_range",
    "audio_tail_range",
    "mapping_recipe",
    "overlap_frames",
    "audio_correction",
    "validity",
    "evidence",
    "generation_key",
    "revision"
  ],
  "additionalProperties": false
