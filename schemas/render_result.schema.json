{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmin-video-director.invalid/schemas/2.0.0/render_result.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kmin.render_result"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+(?![\\s\\S])": {}
      },
      "additionalProperties": false
