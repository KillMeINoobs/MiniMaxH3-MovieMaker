{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmin-video-director.invalid/schemas/2.0.0/segment.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kmin.segment"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$": {}
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "useful_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "source_media_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "source_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "boundary_before": {
      "enum": [
        "first",
        "cut",
        "continue"
      ]
    },
    "continuity_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "overrides": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "prompt_recipe_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "control_spec_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "audio_mode": {
          "enum": [
            "preserve",
            "generate",
            "mute"
          ]
        },
        "reference_binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "uniqueItems": true
        },
        "continuity_policy": {
          "enum": [
            "none",
            "reset",
            "carry"
          ]
        },
        "spatial_policy": {
          "enum": [
            "preserve_display_pad",
            "draft_fit"
          ]
        },
        "render_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "analysis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "prompt_draft_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "resolved_settings_digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "boolean"
    },
    "passthrough": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "revision",
    "project_id",
    "useful_range",
    "source_media_id",
    "source_range",
    "boundary_before",
    "continuity_group_id",
    "overrides",
    "analysis_ids",
    "prompt_draft_ids",
    "selected",
    "passthrough"
  ],
  "additionalProperties": false
}
