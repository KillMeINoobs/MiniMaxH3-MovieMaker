{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmin-video-director.invalid/schemas/2.0.0/scene_analysis.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kmin.scene_analysis"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$": {}
      },
      "additionalProperties": false
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "segment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "segment_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "analyzer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "model_digest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "algorithm": {
                  "const": "sha256"
                },
                "hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "algorithm",
                "hex"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "sampling_recipe": {
      "type": "object"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "sample_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "uniqueItems": true
          },
          "max_sample_gap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "range",
          "sample_ids",
          "max_sample_gap",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "media_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "time": {
            "type": "object",
            "properties": {
              "num": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "den": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false
          },
          "digest": {
            "type": "object",
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "algorithm",
              "hex"
            ],
            "additionalProperties": false
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "media_id",
          "frame",
          "time",
          "digest",
          "duplicate"
        ],
        "additionalProperties": false
      }
    },
    "unobserved_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "max_sample_gap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "subject",
              "action",
              "camera",
              "environment",
              "source_style"
            ]
          },
          "text": {
            "type": "string"
          },
          "event_range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertainty": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "text",
          "event_range",
          "uncertainty"
        ],
        "additionalProperties": false
      }
    },
    "no_inferred_transcript": {
      "const": true
    },
    "transcript_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "message": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "stage",
          "retryable",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "project_id",
    "segment_id",
    "segment_revision",
    "source_digest",
    "analyzer",
    "sampling_recipe",
    "chunks",
    "samples",
    "unobserved_intervals",
    "max_sample_gap",
    "observations",
    "no_inferred_transcript",
    "transcript_id",
    "draft_revision",
    "errors",
    "warnings"
  ],
  "additionalProperties": false
}
