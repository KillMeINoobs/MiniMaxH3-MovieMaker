{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmin-video-director.invalid/schemas/2.0.0/generation_window.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kmin.generation_window"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+(?![\\s\\S])": {}
      },
      "additionalProperties": false
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "segment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "useful_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "inference_frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "output_useful_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "input_spans": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "role": {
                "const": "useful"
              },
              "inference_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "media_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
              },
              "source_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "role",
              "inference_range",
              "media_id",
              "source_range"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "const": "padding"
              },
              "inference_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "repeat_frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "role",
              "inference_range",
              "repeat_frame"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "const": "context"
              },
              "inference_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "continuation_state_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
              },
              "tail_map_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
              },
              "source_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "role",
              "inference_range",
              "continuation_state_id",
              "tail_map_id",
              "source_range"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "structural_source",
            "previous_generated"
          ]
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dependency_result_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "continuation_state_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "before",
        "after",
        "dependency_result_ids",
        "continuation_state_id"
      ],
      "additionalProperties": false
    },
    "padding": {
      "type": "object",
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "method": {
          "const": "repeat_boundary"
        }
      },
      "required": [
        "before",
        "after",
        "method"
      ],
      "additionalProperties": false
    },
    "spatial_transform_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "control_spec_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "render_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
    },
    "resolved_settings": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "prompt_recipe_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
        },
        "control_spec_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
        },
        "audio_mode": {
          "enum": [
            "preserve",
            "generate",
            "mute"
          ]
        },
        "reference_binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "continuity_policy": {
          "enum": [
            "none",
            "reset",
            "carry"
          ]
        },
        "spatial_policy": {
          "enum": [
            "preserve_display_pad",
            "draft_fit"
          ]
        },
        "render_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
        }
      },
      "required": [
        "prompt",
        "prompt_recipe_id",
        "seed",
        "control_spec_id",
        "audio_mode",
        "reference_binding_ids",
        "continuity_policy",
        "spatial_policy",
        "render_profile_id"
      ],
      "additionalProperties": false
    },
    "resolved_settings_digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "plan_digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "generation_key": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "compiled_prompt": {
      "type": "string"
    },
    "prompt_recipe_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "media_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "content_digest": {
            "type": "object",
            "properties": {
              "algorithm": {
                "const": "sha256"
              },
              "hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            },
            "required": [
              "algorithm",
              "hex"
            ],
            "additionalProperties": false
          },
          "socket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[^\\x00-\\x1f\\x7f]+(?![\\s\\S])"
          },
          "role": {
            "enum": [
              "identity",
              "appearance",
              "costume",
              "object",
              "style"
            ]
          }
        },
        "required": [
          "binding_id",
          "subject_id",
          "media_id",
          "content_digest",
          "socket",
          "label",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "project_id",
    "segment_id",
    "plan_revision",
    "ordinal",
    "useful_range",
    "inference_frame_count",
    "output_useful_range",
    "input_spans",
    "context",
    "padding",
    "spatial_transform_id",
    "control_spec_id",
    "render_profile_id",
    "resolved_settings",
    "resolved_settings_digest",
    "plan_digest",
    "generation_key",
    "compiled_prompt",
    "prompt_recipe_id",
    "reference_manifest"
  ],
  "additionalProperties": false
}
