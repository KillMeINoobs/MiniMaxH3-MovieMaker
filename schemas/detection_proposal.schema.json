{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmin-video-director.invalid/schemas/2.0.0/detection_proposal.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kmin.detection_proposal"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$": {}
      },
      "additionalProperties": false
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "canonical_media_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "source_digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "boundary_frame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "detector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "parameters"
      ],
      "additionalProperties": false
    },
    "score": {
      "type": "number"
    },
    "score_scale": {
      "type": "string"
    },
    "evidence_media_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "adjusted"
      ]
    },
    "accepted_boundary": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "project_id",
    "canonical_media_id",
    "source_digest",
    "boundary_frame",
    "detector",
    "score",
    "score_scale",
    "evidence_media_ids",
    "state",
    "accepted_boundary",
    "decision_revision"
  ],
  "additionalProperties": false
}
